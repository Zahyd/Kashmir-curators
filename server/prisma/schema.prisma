generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                String             @id @default(uuid())
  email             String             @unique
  name              String
  emailVerified     Boolean            @default(false)
  image             String?
  password          String?
  phone             String?
  role              String             @default("user") // user, admin, sales, operations, finance, agent, supplier, driver
  employeeCode      String?            @unique
  isOnline          Boolean            @default(false)
  leadCapacity      Int                @default(5)
  bookings          Booking[]
  inquiries         Inquiry[]
  agentInquiries    Inquiry[]          @relation("AgentInquiries")
  hotelReservations HotelReservation[] @relation("UserReservations")
  uploadedDocuments String?            // JSON string of uploaded documents
  agentProfile      AgentProfile?
  driverProfile     DriverProfile?
  supplierProfile   Supplier?
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt

  sessions      Session[]
  accounts      Account[]
}

model Package {
  id            String   @id @default(uuid())
  name          String
  destination   String
  duration      String
  price         Float
  originalPrice Float
  rating        Float    @default(0)
  reviewCount   Int      @default(0)
  image         String
  highlights    String   // JSON string or comma-separated
  inclusions    String   // JSON string or comma-separated
  exclusions    String   // JSON string or comma-separated
  itinerary     String   // JSON string
  bestSeason    String
  difficulty    String
  isActive      Boolean  @default(true)
  isFeatured    Boolean  @default(false)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

model Hotel {
  id                  String             @id @default(uuid())
  name                String
  location            String
  starRating          Int
  rating              Float              @default(0)
  reviewCount         Int                @default(0)
  pricePerNight       Float
  image               String
  description         String
  amenities           String             // JSON string
  roomTypes           String             // JSON string
  isActive            Boolean            @default(true)
  contactName         String?
  contactEmail        String?
  contactPhone        String?
  receptionEmail      String?
  reservationsEmail   String?
  managerName         String?
  whatsappNumber      String?
  alternatePhone      String?
  emergencyContact    String?
  address             String?
  cancellationPolicy  String?
  taxRatePct          Float?             @default(12.0)
  bankName            String?
  bankAccountNumber   String?
  bankIfsc            String?
  bankAccountName     String?
  paymentTerms        String?
  commissionStructure String?
  seasonalPricing     String?            // JSON string
  reservations        HotelReservation[]
  roomCategories      RoomCategory[]
  rooms               HotelRoom[]
  maintenance         MaintenanceRequest[]
  housekeepingTasks   HousekeepingTask[]
  winterOpsLogs       WinterOpsLog[]
  settlements         VendorSettlement[]
  reviews             HotelReview[]
  createdAt           DateTime           @default(now())
  updatedAt           DateTime           @updatedAt
}

model Cab {
  id           String           @id @default(uuid())
  type         String
  name         String
  capacity     Int
  pricePerKm   Float
  basePrice    Float
  image        String
  features     String           // JSON string
  isActive     Boolean          @default(true)
  reservations CabReservation[]
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt
}

model Testimonial {
  id          String   @id @default(uuid())
  name        String
  avatar      String
  location    String
  rating      Int
  content     String
  packageName String?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
}

model FAQ {
  id        String   @id @default(uuid())
  question  String
  answer    String
  category  String   @default("general")
  sortOrder Int      @default(0)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
}

model Booking {
  id           String   @id @default(uuid())
  userId       String
  user         User     @relation(fields: [userId], references: [id])
  type         String   // hotel, package, cab
  itemName     String
  bookingDate  DateTime
  status       String   @default("pending") // pending, confirmed, cancelled
  stage        String   @default("DRAFT") // DRAFT, SUPPLIER_REQUESTED, CONFIRMED, VOUCHERED, EXECUTED, COMPLETED, CANCELLED
  totalAmount  Float
  details      String   // JSON string
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model Inquiry {
  id                String             @id @default(uuid())
  userId            String?
  user              User?              @relation(fields: [userId], references: [id])
  customerName      String
  email             String
  phone             String
  destination       String
  duration          String
  travelers         String
  budget            String
  accommodation     String
  status            String             @default("New") // New, Pending Curation, Ready for Review, Booked, Lost
  leadStage         String             @default("NEW_LEAD") // NEW_LEAD, FOLLOW_UP, QUOTE_SENT, NEGOTIATION, PAYMENT_PENDING, CONFIRMED, COMPLETED, CANCELLED
  assignedTo        String?            // Sales team user code
  priority          String?            // Low, Medium, High
  sentiment         String?            // Cold, Warm, Hot, Ready to Book
  quoteData         String?            // JSON string of days/pricing
  proposalUrl       String?            // URL to uploaded PDF
  flightDetails     String?            // JSON string of flight preferences / enquiry details
  feedback          String?            // Client comments / modification requests
  netPrice          Float              @default(0.0)
  agentMarkup       Float              @default(0.0)
  agentId           String?
  agent             User?              @relation("AgentInquiries", fields: [agentId], references: [id])
  hotelReservations HotelReservation[]
  
  // Phase 1: Lead Capture, Scoring & Progressive Profiling Engine
  leadId                 String?            @unique // e.g. "KC-2026-8942"
  leadScore              Int                @default(0) // 0 to 100
  leadCategory           String?            // HONEYMOON_LUXURY, NORTH_KASHMIR_OFFBEAT, FAMILY_EXPEDITION, etc.
  intentQuery            String?            // What visitor searched or requested
  travelStartDate        DateTime?
  travelEndDate          DateTime?
  adultsCount            Int                @default(2)
  childrenCount          Int                @default(0)
  arrivalCity            String?            // "Srinagar (SXR)", "Jammu (IXJ)"
  nightsCount            Int?
  budgetRange            String?            // Standard, Premium, Luxury VIP
  preferredAccommodation String?
  transportPreference    String?            // Sedan, SUV, Innova Crysta, Coach
  placesVisited          String?            // First-time or list of visited places
  travelStyle            String?            // Romantic, Offbeat Explorer, Family Leisure, Adventure
  wantOffbeat            String?            // Yes / No / Mix
  sourceCta              String?            // HERO_ITINERARY, PLAN_MY_TRIP, CUSTOM_PACKAGE, EXPERT_TALK, CALLBACK_MODAL
  scoringBreakdown       String?            // JSON string breakdown of score points
  profileCompleteness    Int                @default(25) // 25% to 100%
  notes                  String?

  // Intelligent CRM & Operations Relations
  activities             LeadActivity[]
  internalNotes          LeadNote[]
  reminders              FollowUpReminder[]
  whatsappMessages       WhatsAppMessage[]
  cabReservations        CabReservation[]
  duplicateOfId          String?            // Inquiries flagged as potential duplicates
  lastContactedAt        DateTime?
  nextFollowUpDate       DateTime?

  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt

  @@index([phone])
  @@index([email])
  @@index([leadStage])
  @@index([assignedTo])
  @@index([createdAt])
}

model LeadActivity {
  id          String   @id @default(uuid())
  inquiryId   String
  inquiry     Inquiry  @relation(fields: [inquiryId], references: [id], onDelete: Cascade)
  type        String   // STAGE_CHANGE, NOTE_ADDED, WHATSAPP_SENT, WHATSAPP_RECEIVED, QUOTE_DISPATCHED, PAYMENT_CAPTURED, CALL_LOGGED, AI_RECOMMENDATION
  title       String
  description String
  metadata    String?  // JSON string of contextual payload
  performedBy String?  // User code, name, or 'SYSTEM'
  createdAt   DateTime @default(now())

  @@index([inquiryId])
  @@index([createdAt])
}

model LeadNote {
  id          String   @id @default(uuid())
  inquiryId   String
  inquiry     Inquiry  @relation(fields: [inquiryId], references: [id], onDelete: Cascade)
  authorId    String?
  authorName  String
  content     String
  isInternal  Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([inquiryId])
}

model FollowUpReminder {
  id          String    @id @default(uuid())
  inquiryId   String
  inquiry     Inquiry   @relation(fields: [inquiryId], references: [id], onDelete: Cascade)
  assignedTo  String?   // Employee code or email
  title       String
  dueDate     DateTime
  priority    String    @default("MEDIUM") // LOW, MEDIUM, HIGH, URGENT
  status      String    @default("PENDING") // PENDING, COMPLETED, OVERDUE, CANCELLED
  completedAt DateTime?
  notes       String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([inquiryId])
  @@index([assignedTo, status])
  @@index([dueDate])
}

model WhatsAppMessage {
  id            String   @id @default(uuid())
  inquiryId     String?
  inquiry       Inquiry? @relation(fields: [inquiryId], references: [id], onDelete: SetNull)
  customerPhone String
  direction     String   // INBOUND, OUTBOUND
  messageType   String   @default("text") // text, template, image, document
  templateName  String?
  content       String
  status        String   @default("SENT") // PENDING, SENT, DELIVERED, READ, FAILED
  metaMessageId String?  @unique
  senderId      String?  // Agent user ID or 'SYSTEM' or 'CUSTOMER'
  senderName    String?
  createdAt     DateTime @default(now())

  @@index([customerPhone])
  @@index([inquiryId])
  @@index([createdAt])
}

model CabReservation {
  id                 String   @id @default(uuid())
  inquiryId          String?
  inquiry            Inquiry? @relation(fields: [inquiryId], references: [id], onDelete: SetNull)
  bookingId          String?
  cabId              String
  cab                Cab      @relation(fields: [cabId], references: [id])
  driverName         String?
  driverPhone        String?
  vehicleRegNo       String?
  pickupLocation     String
  dropLocation       String
  startDate          DateTime
  endDate            DateTime
  status             String   @default("ALLOCATED") // ALLOCATED, DISPATCHED, ON_TRIP, COMPLETED, CANCELLED
  totalCost          Float    @default(0.0)
  contractRate       Float    @default(0.0)
  profitMargin       Float    @default(0.0)
  voucherReference   String?  @unique
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  @@index([inquiryId])
  @@index([cabId])
}

model Media {
  id           String   @id @default(uuid())
  filename     String
  originalName String
  url          String
  size         Int?
  mimeType     String?
  publicId     String?  // Cloudinary public_id
  createdAt    DateTime @default(now())
}

model TransactionLedger {
  id           String   @id @default(uuid())
  bookingId    String
  amount       Float
  type         String   // CREDIT, DEBIT
  paymentId    String   @unique
  orderId      String
  description  String?
  createdAt    DateTime @default(now())
}

model BlogPost {
  id          String   @id @default(uuid())
  title       String
  slug        String   @unique
  excerpt     String
  content     String
  author      String
  imageUrl    String?
  seoKeywords String?
  published   Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model SeasonalCampaign {
  id          String   @id @default(uuid())
  name        String
  slug        String   @unique
  season      String   // Winter, Spring, Summer, Autumn
  description String
  bannerImage String?
  isActive    Boolean  @default(false)
  startDate   DateTime?
  endDate     DateTime?
  packages    String   // JSON array of associated package IDs
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Session {
  id        String   @id @default(uuid())
  expiresAt DateTime
  token     String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  ipAddress String?
  userAgent String?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Account {
  id                    String    @id @default(uuid())
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt
}

model Verification {
  id         String    @id @default(uuid())
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
}

model SiteContent {
  id         String   @id @default(uuid())
  sectionKey String   @unique
  title      String?
  subtitle   String?
  content    Json
  imageUrl   String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}

model Curator {
  id           String    @id @default(uuid())
  name         String
  role         String
  licenseNo    String
  avatar       String
  bio          String
  languages    String
  phone        String
  rating       Float     @default(5.0)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
}

model TravelAdvisory {
  id                  String             @id @default(uuid())
  location            String
  status              String             // Open, Caution, Closed, Restricted
  message             String
  severity            String             @default("NORMAL") // NORMAL, ADVISORY, WARNING, SEVERE, CRITICAL_EMERGENCY
  category            String             @default("GENERAL") // ROAD_HIGHWAY, WEATHER_SNOW, AVALANCHE, FLIGHT_AIRPORT, DESTINATION_RESTRICTION, GOVERNMENT
  corridors           String?            // JSON array of affected routes/corridors
  source              String             @default("J&K Tourism & Administration")
  sourceUrl           String?
  validFrom           DateTime?          @default(now())
  validUntil          DateTime?
  recommendedAction   String?
  isVerified          Boolean            @default(true)
  emergencyModeActive Boolean            @default(false)
  disruptionImpacts   DisruptionImpact[]
  lastUpdated         DateTime           @default(now())
  updatedAt           DateTime           @updatedAt
}

model PackageReview {
  id           String    @id @default(uuid())
  packageId    String
  userId       String?
  userName     String
  userAvatar   String?
  rating       Int
  text         String
  date         DateTime  @default(now())
  helpful      Int       @default(0)
  tripType     String?
  isVerified   Boolean   @default(false)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
}

model HotelReservation {
  id                      String    @id @default(uuid())
  inquiryId               String?
  inquiry                 Inquiry?  @relation(fields: [inquiryId], references: [id])
  hotelId                 String
  hotel                   Hotel     @relation(fields: [hotelId], references: [id])
  guestName               String
  guestEmail              String?
  guestPhone              String?
  checkIn                 DateTime
  checkOut                DateTime
  roomType                String
  roomsCount              Int       @default(1)
  mealPlan                String    // EP, CP, MAP, AP
  specialRequests         String?
  status                  String    @default("Pending") // Pending, Sent, Confirmed, Hold, Rejected, Cancelled
  confirmationStage       String    @default("PENDING_RESPONSE") // PENDING_RESPONSE, AVAILABILITY_CONFIRMED, ALTERNATIVE_OFFERED, HOTEL_CONFIRMED, REJECTED_UNAVAILABLE, EXPIRED, CANCELLED
  paymentStatus           String    @default("Unpaid")  // Unpaid, Partially Paid, Paid
  bookingReference        String?
  contractRate            Float     @default(0)
  seasonalPricing         Float?
  commissionRate          Float     @default(0)
  totalAmount             Float     @default(0)
  profitMargin            Float     @default(0)
  hotelDues               Float     @default(0)
  holdUntil               DateTime? // hold countdown timer
  assignedRoomId          String?
  assignedRoomNumber      String?
  adults                  Int       @default(2)
  children                Int       @default(0)
  guestIdType             String?
  guestIdNumber           String?
  guestIdVerified         Boolean   @default(false)
  checkInTime             DateTime?
  checkOutTime            DateTime?
  agentName               String?
  internalNotes           String?
  createdById             String?
  createdBy               User?     @relation("UserReservations", fields: [createdById], references: [id])
  auditLogs               String?   // JSON string of updates/actions

  // Hotel Reception Confirmation Portal Fields
  secureToken             String?   @unique
  tokenExpiresAt          DateTime?
  confirmationDeadline    DateTime?
  receptionContact        String?
  receptionEmail          String?
  receptionPhone          String?
  hotelConfirmationNumber String?
  confirmedRoomType       String?
  confirmedRoomsCount     Int?
  confirmedTariff         Float?
  confirmedTaxes          Float?
  confirmedMealPlan       String?
  confirmationVoucherUrl  String?
  receptionNotes          String?
  rejectionReason         String?
  alternativeRoomType     String?
  alternativeTariff       Float?
  alternativeDates        String?
  alternativeNotes        String?
  clarificationRequest    String?
  clarificationResponse   String?
  respondedAt             DateTime?
  respondedBy             String?

  createdAt               DateTime  @default(now())
  updatedAt               DateTime  @updatedAt
}

model AgentProfile {
  id             String   @id @default(uuid())
  companyName    String
  licenseNumber  String?
  agentCode      String   @unique
  commissionPct  Float    @default(0.0)
  status         String   @default("PENDING") // PENDING, APPROVED, REJECTED
  plan           String   @default("STARTER") // STARTER, PROFESSIONAL, ENTERPRISE
  billingCycle   String   @default("MONTHLY") // MONTHLY, ANNUAL
  city           String?
  state          String?
  website        String?
  applicationRef String?
  userId         String   @unique
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model AgencyApplication {
  id                 String    @id @default(uuid())
  applicationRef     String    @unique // e.g. "KCB2B-2026-8942"
  agencyName         String
  authorizedPerson   String
  email              String
  phone              String
  location           String    // City, State, Country
  websiteOrSocial    String?
  businessCategory   String    @default("TOUR_OPERATOR") // TOUR_OPERATOR, TRAVEL_AGENT, CORPORATE_DESK, FREELANCE_CURATOR
  tourismLicenseNo   String?
  gstin              String?
  documentUrl        String?
  status             String    @default("SUBMITTED") // SUBMITTED, UNDER_REVIEW, DOCUMENTS_VERIFIED, APPROVED, REJECTED, NEEDS_INFO
  adminRemarks       String?
  selectedPlan       String    @default("STARTER") // STARTER, PROFESSIONAL, ENTERPRISE
  billingCycle       String    @default("MONTHLY") // MONTHLY, ANNUAL
  userId             String?   // Linked user if account already created
  reviewedAt         DateTime?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  @@index([email])
  @@index([phone])
  @@index([applicationRef])
  @@index([status])
}

model DriverProfile {
  id                 String   @id @default(uuid())
  licenseNumber      String
  vehicleRegNo       String
  status             String   @default("AVAILABLE") // AVAILABLE, BUSY, OFFLINE
  rating             Float    @default(4.8)
  tripsCompleted     Int      @default(0)
  earnings           Float    @default(0)
  attendance         String   @default("Present") // Present, Absent, Off Duty
  licenseExpiry      String   @default("2027-12-31")
  policeVerification String   @default("Verified") // Verified, Pending, Expired
  aadhaar            String   @default("0000-0000-0000")
  experience         Int      @default(3)
  languages          String   @default("English, Kashmiri, Urdu")
  emergencyContact   String   @default("+919876543219")
  userId             String   @unique
  user               User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @default(now()) @updatedAt
}

model Supplier {
  id             String   @id @default(uuid())
  companyName    String
  contactPerson  String
  email          String
  phone          String
  type           String   // HOTEL, TRANSPORT, GUIDE
  userId         String?  @unique
  user           User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
}

model AuditLog {
  id        String   @id @default(uuid())
  userId    String
  action    String
  details   String   // JSON string of changes
  createdAt DateTime @default(now())
}

model Notification {
  id        String   @id @default(uuid())
  userId    String?  // Target user code or ID, null for global/admin
  title     String
  message   String
  type      String   // info, success, warning, booking, inquiry, payment
  read      Boolean  @default(false)
  priority  String   @default("medium") // low, medium, high
  link      String?  // Redirect link (e.g. /admin)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model RoomCategory {
  id             String         @id @default(uuid())
  hotelId        String
  hotel          Hotel          @relation(fields: [hotelId], references: [id], onDelete: Cascade)
  name           String         // e.g. Deluxe Room, Super Deluxe, Presidential Suite
  basePrice      Float
  capacity       Int            @default(2)
  maxOccupancy   Int            @default(3)
  amenities      String         // JSON list of room amenities
  imageUrl       String?
  rooms          HotelRoom[]
  seasonalRates  SeasonalRate[]
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt
}

model HotelRoom {
  id                  String         @id @default(uuid())
  hotelId             String
  hotel               Hotel          @relation(fields: [hotelId], references: [id], onDelete: Cascade)
  categoryId          String
  category            RoomCategory   @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  roomNumber          String
  floor               String?
  status              String         @default("AVAILABLE") // AVAILABLE, OCCUPIED, MAINTENANCE
  operationalStatus   String         @default("AVAILABLE_CLEAN") // AVAILABLE_CLEAN, AVAILABLE_DIRTY, OCCUPIED, RESERVED, CHECK_IN_DUE, CHECK_OUT_DUE, OUT_OF_SERVICE, UNDER_MAINTENANCE
  housekeeping        String         @default("CLEAN")     // DIRTY, CLEAN, INSPECTED
  bukhariActive       Boolean        @default(false)
  electricWarmerActive Boolean       @default(false)
  currentReservationId String?
  assignedHousekeeper String?
  housekeepingPriority String?       @default("NORMAL")
  maintenanceNotes    String?
  createdAt           DateTime       @default(now())
  updatedAt           DateTime       @updatedAt
}

model SeasonalRate {
  id             String         @id @default(uuid())
  categoryId     String
  category       RoomCategory   @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  seasonName     String         // Summer High, Winter Gold, etc.
  startDate      DateTime
  endDate        DateTime
  multiplier     Float          @default(1.0)
  flatRate       Float?
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt
}

model MaintenanceRequest {
  id             String         @id @default(uuid())
  hotelId        String
  hotel          Hotel          @relation(fields: [hotelId], references: [id], onDelete: Cascade)
  roomNumber     String
  task           String
  priority       String         @default("MEDIUM") // LOW, MEDIUM, HIGH
  status         String         @default("PENDING") // PENDING, IN_PROGRESS, RESOLVED
  cost           Float          @default(0)
  loggedBy       String?
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt
}

model VendorSettlement {
  id                String         @id @default(uuid())
  hotelId           String
  hotel             Hotel          @relation(fields: [hotelId], references: [id], onDelete: Cascade)
  amount            Float
  commissionDues    Float
  netPaid           Float
  payoutDate        DateTime       @default(now())
  status            String         @default("COMPLETED") // COMPLETED, PENDING, REJECTED
  transactionRef    String?
  bankAccountName   String?
  bankAccountNumber String?
  ifscCode          String?
  notes             String?
  bookingIds        String?        // JSON array of settled reservation IDs
  createdAt         DateTime       @default(now())
  updatedAt         DateTime       @updatedAt
}

model HousekeepingTask {
  id             String    @id @default(uuid())
  hotelId        String
  hotel          Hotel     @relation(fields: [hotelId], references: [id], onDelete: Cascade)
  roomNumber     String
  taskType       String    @default("TURNOVER") // TURNOVER, DAILY_CLEAN, DEEP_CLEAN, INSPECTION, LINEN_CHANGE
  priority       String    @default("NORMAL")   // LOW, NORMAL, HIGH, URGENT
  status         String    @default("DIRTY")    // DIRTY, IN_PROGRESS, CLEAN, INSPECTED
  assignedTo     String?
  notes          String?
  linenChanged   Boolean   @default(true)
  inspectedBy    String?
  completedAt    DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
}

model WinterOpsLog {
  id                  String    @id @default(uuid())
  hotelId             String
  hotel               Hotel     @relation(fields: [hotelId], references: [id], onDelete: Cascade)
  bukhariStatus       String    @default("OPERATIONAL") // OPERATIONAL, FUEL_LOW, OFF
  firewoodStockDays   Int       @default(7)
  generatorStatus     String    @default("STANDBY")     // RUNNING, STANDBY, MAINTENANCE
  generatorFuelPct    Int       @default(85)
  generatorRuntimeHrs Float     @default(0)
  gridPowerStatus     String    @default("LIVE")        // LIVE, OUTAGE, FLUCTUATING
  boilerHotWater      String    @default("ACTIVE")      // ACTIVE, REHEATING, FAULT
  snowRoadClearance   String    @default("CLEAR")       // CLEAR, 4X4_ONLY, CHAINS_REQUIRED, BLOCKED
  shikaraGhatStatus   String?   @default("OPEN")
  notes               String?
  updatedBy           String?
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt
}

model HotelReview {
  id             String         @id @default(uuid())
  hotelId        String
  hotel          Hotel          @relation(fields: [hotelId], references: [id], onDelete: Cascade)
  guestName      String
  rating         Float
  comment        String
  sentiment      String         @default("POSITIVE") // POSITIVE, NEUTRAL, NEGATIVE
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt
}

model DisruptionImpact {
  id                    String          @id @default(uuid())
  advisoryId            String
  advisory              TravelAdvisory  @relation(fields: [advisoryId], references: [id], onDelete: Cascade)
  bookingId             String?
  inquiryId             String?
  affectedDestination   String
  affectedDateFrom      DateTime?
  affectedDateTo        DateTime?
  impactLevel           String          @default("MEDIUM") // LOW, MEDIUM, HIGH, CRITICAL
  suggestedAlternative String?         // JSON: alternate destination, hotels, cab reroute
  status                String          @default("DETECTED") // DETECTED, NOTIFIED, ALTERNATIVE_PROPOSED, RESOLVED, CANCELLED
  resolutionType        String?         // REROUTED, RESCHEDULED, WALLET_CREDITED, REFUNDED
  customerNotified      Boolean         @default(false)
  agentNotified         Boolean         @default(false)
  createdAt             DateTime        @default(now())
  updatedAt             DateTime        @updatedAt
}

model BookingProtectionPolicy {
  id                    String   @id @default(uuid())
  name                  String   // e.g. "Kashmir Flex Protection", "Standard Protection"
  code                  String   @unique
  description           String
  feePercentage         Float    @default(5.0) // 5% of booking value
  freeRescheduleDays    Int      @default(30)
  cancellationRefundPct Float    @default(100.0) // In platform wallet credits
  disruptionAutoCredit  Boolean  @default(true)
  isActive              Boolean  @default(true)
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt
}

model VendorListing {
  id                  String    @id @default(uuid())
  vendorId            String    // references User.id or Supplier.id
  title               String
  category            String    // HOTEL, HOMESTAY, CAB, GUIDE, ACTIVITY, RESTAURANT
  location            String
  description         String
  basePrice           Float
  images              String    // JSON array of URLs
  amenitiesOrFeatures String    // JSON array
  inventoryCount      Int       @default(1)
  blackoutDates       String?   // JSON array of ISO dates
  verificationStatus  String    @default("PENDING") // PENDING, VERIFIED, REJECTED, SUSPENDED
  kycDocuments        String?   // JSON object with govt ids, trade licenses
  rating              Float     @default(5.0)
  reviewCount         Int       @default(0)
  contactPhone        String?
  contactEmail        String?
  payoutUpiOrBank     String?   // JSON payout details
  isActive            Boolean   @default(true)
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt
}

model Wallet {
  id        String              @id @default(uuid())
  userId    String              @unique
  balance   Float               @default(0.0)
  currency  String              @default("INR")
  history   WalletTransaction[]
  createdAt DateTime            @default(now())
  updatedAt DateTime            @updatedAt
}

model WalletTransaction {
  id          String   @id @default(uuid())
  walletId    String
  wallet      Wallet   @relation(fields: [walletId], references: [id], onDelete: Cascade)
  amount      Float
  type        String   // CREDIT, DEBIT
  source      String   // DISRUPTION_REFUND, CANCELLATION_CREDIT, PROMOTIONAL, BOOKING_PAYMENT
  referenceId String?  // bookingId or disruptionImpactId
  description String
  createdAt   DateTime @default(now())
}

model TripSafetyCard {
  id                String   @id @default(uuid())
  bookingId         String?  @unique
  inquiryId         String?  @unique
  shareToken        String   @unique
  passengerName     String
  passengerPhone    String
  travelerCount     Int      @default(1)
  assignedDriver    String?  // JSON: { name, phone, vehicleNo, vehicleType }
  assignedHotelSos  String?  // JSON: { hotelName, location, managerPhone, frontDeskPhone }
  emergencyContacts String?  // JSON array: [ { name, relation, phone } ]
  bloodGroup        String?
  medicalNotes      String?
  safetyStatus      String   @default("SAFE") // SAFE, ROUTE_MONITORED, ASSISTANCE_REQUESTED
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
}

model PortalAccessKey {
  id              String    @id @default(uuid())
  portalType      String    // HOSPITALITY, SALES, DRIVER, VENDOR, OPERATIONS
  accessKey       String    @unique // e.g. KC-HOSP-98421 or KC-SALE-78120
  assignedName    String    // Teammate or Partner Name
  assignedContact String?   // Email or Phone number
  designation     String?   // e.g. "Senior Reservation Officer"
  propertyScope   String?   // "ALL" or specific hotel ID / names
  status          String    @default("ACTIVE") // ACTIVE, REVOKED, EXPIRED
  expiresAt       DateTime?
  lastUsedAt      DateTime?
  usageCount      Int       @default(0)
  createdByName   String?   // SuperAdmin who created it
  notes           String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@index([accessKey])
  @@index([portalType])
  @@index([status])
}

model EmployeeAttendance {
  id                String    @id @default(uuid())
  employeeCode      String    // e.g. KC-HOSP-01 or ADMIN001
  employeeName      String
  role              String    // hospitality, operations, admin, etc.
  date              String    // YYYY-MM-DD (Asia/Kolkata timezone standard)
  firstLoginAt      DateTime  @default(now())
  lastLogoutAt      DateTime?
  totalWorkMinutes  Int       @default(0)
  totalBreakMinutes Int       @default(0)
  status            String    @default("PRESENT") // PRESENT, HALF_DAY, OVERTIME, ON_BREAK, CLOCKED_OUT
  shiftName         String    @default("General Operations (09:00 - 18:00)")
  ipAddress         String?
  deviceInfo        String?
  notes             String?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  @@unique([employeeCode, date])
  @@index([employeeCode])
  @@index([date])
  @@index([status])
}

model EmployeeSession {
  id             String    @id @default(uuid())
  employeeCode   String
  employeeName   String
  role           String
  portalType     String    @default("HOSPITALITY")
  loginAt        DateTime  @default(now())
  logoutAt       DateTime?
  lastActivityAt DateTime  @default(now())
  isActive       Boolean   @default(true)
  isOnBreak      Boolean   @default(false)
  breakStartAt   DateTime?
  breakMinutes   Int       @default(0)
  assignedDesk   String?   // e.g. "Gulmarg Desk", "Central Reservations"
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@index([employeeCode])
  @@index([isActive])
  @@index([portalType])
}
